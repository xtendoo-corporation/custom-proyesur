<?xml version="1.0" ?>
<odoo>
    <data>
        <template
            id="document_format_proyesur.report_invoice_document_proyesur"
            inherit_id="account.report_invoice_document"
        >
            <xpath expr="//div[@id='informations']/div[@name='origin']" position="replace"/>
        </template>

        <template
            id="document_format_proyesur.document_tax_totals_document_proyesur"
            inherit_id="account.document_tax_totals"
        >
            <xpath expr="//tr[contains(@class, 'o_total')]" position="replace">
                <t t-if="(o and o.tiene_retenciones) or tiene_retenciones">
                    <tr class="border-black o_total">
                        <td>
                            <strong>Total factura</strong>
                        </td>
                        <td class="text-right">
                            <span t-esc="tax_totals['total_without_retention']"/>
                        </td>
                    </tr>
                    <tr class="border-black o_total">
                        <td>
                            <strong>Total a pagar</strong>
                        </td>
                        <td class="text-right">
                            <span t-esc="tax_totals['formatted_amount_total']"/>
                        </td>
                    </tr>
                </t>
                <t t-if="not ((o and o.tiene_retenciones) or tiene_retenciones)">
                    <tr class="border-black o_total">
                        <td>
                            <strong>Total</strong>
                        </td>
                        <td class="text-right">
                            <span t-esc="tax_totals['formatted_amount_total']"/>
                        </td>
                    </tr>
                </t>
            </xpath>
        </template>
    </data>
</odoo>
