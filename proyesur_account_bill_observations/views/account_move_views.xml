<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_proyesur_observaciones" model="ir.ui.view">
        <field name="name">account.move.form.inherit.proyesur.observaciones</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@id='header_left_group']/field[@name='invoice_vendor_bill_id']" position="after">
                <field name="observaciones"
                       placeholder="Añadir observaciones..."
                       invisible="move_type not in ('in_invoice', 'in_refund')"/>
            </xpath>
        </field>
    </record>

    <record id="view_in_invoice_bill_tree_inherit_proyesur_observaciones" model="ir.ui.view">
        <field name="name">account.move.list.inherit.proyesur.observaciones</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_in_invoice_bill_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='ref']" position="after">
                <field name="observaciones" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>

