<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_attendance_tree_proyesur_cost" model="ir.ui.view">
        <field name="name">hr.attendance.list.proyesur.cost</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance_work_center.view_attendance_tree_inherit"/>
        <field name="arch" type="xml">
            <field name="coste_total" position="after">
                <field name="daily_cost" string="Coste del día" optional="show"/>
            </field>
        </field>
    </record>

    <record id="hr_attendance_view_form_proyesur_cost" model="ir.ui.view">
        <field name="name">hr.attendance.form.proyesur.cost</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance_work_center.view_attendance_form_inherit"/>
        <field name="arch" type="xml">
            <field name="coste_total" position="after">
                <field name="daily_cost" string="Coste del día"/>
            </field>
        </field>
    </record>
</odoo>
