<odoo>
    <record id="view_hr_attendance_update_wizard" model="ir.ui.view">
        <field name="name">hr.attendance.workcenter.update.wizard</field>
        <field name="model">hr.attendance.workcenter.update</field>
        <field name="arch" type="xml">
            <form string="Actualizar Work Center desde CSV">
                <group>
                    <field name="file"/>
                    <field name="filename"/>
                </group>
                <footer>
                    <button string="Actualizar" type="object" name="action_update_workcenter" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_hr_attendance_workcenter_update" model="ir.actions.act_window">
        <field name="name">Actualizar Work Center</field>
        <field name="res_model">hr.attendance.workcenter.update</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_hr_attendance_workcenter_update"
              name="Actualizar Work Center"
              parent="hr_attendance.hr_attendance_menu_root"
              action="action_hr_attendance_workcenter_update"
              sequence="20"/>
</odoo>
