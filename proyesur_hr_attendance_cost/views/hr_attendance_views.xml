<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_attendance_tree_proyesur_cost" model="ir.ui.view">
        <field name="name">hr.attendance.list.proyesur.cost</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance_work_center.view_attendance_tree_inherit"/>
        <field name="arch" type="xml">
            <field name="coste_total" position="after">
                <field name="daily_cost" string="Coste del día" optional="show"/>
                <field name="employee_currency_id" column_invisible="1"/>
                <field name="employee_cost_per_day" optional="show" groups="hr.group_hr_user"/>
            </field>
        </field>
    </record>

    <record id="hr_attendance_view_form_proyesur_cost" model="ir.ui.view">
        <field name="name">hr.attendance.form.proyesur.cost</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance_work_center.view_attendance_form_inherit"/>
        <field name="arch" type="xml">
            <field name="coste_total" position="after">
                <field name="daily_cost" string="Coste del día"/>
            </field>
        </field>
    </record>

    <record id="view_employee_form_proyesur_cost_per_day" model="ir.ui.view">
        <field name="name">hr.employee.form.proyesur.cost.per.day</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr_hourly_cost.view_employee_form"/>
        <field name="arch" type="xml">
            <div name="hourly_cost" position="after">
                <label for="cost_per_day"/>
                <div name="cost_per_day">
                    <field name="cost_per_day" class="oe_inline"/>
                </div>
            </div>
        </field>
    </record>
</odoo>
